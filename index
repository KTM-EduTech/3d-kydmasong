  <style>
    /* ---------- Tokens ---------- */
    :root {
      --bg: #d8e5ec;
      --ink: #0f1b33;
      --muted: #42536e;
      --accent: #2f4bff;
      --line: rgba(15, 27, 51, 0.2);
      --panel: rgba(216, 229, 236, 0.84);
      --display: 'Bricolage Grotesque', 'Avenir Next', 'Segoe UI', system-ui, sans-serif;
      --text: 'Newsreader', Georgia, 'Times New Roman', serif;
      box-sizing: border-box;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #0c1630;
        --ink: #e6edf9;
        --muted: #a3b2cc;
        --accent: #8fa2ff;
        --line: rgba(230, 237, 249, 0.22);
        --panel: rgba(12, 22, 48, 0.8);
      }
    }
    :root[data-theme="dark"] {
      --bg: #0c1630;
      --ink: #e6edf9;
      --muted: #a3b2cc;
      --accent: #8fa2ff;
      --line: rgba(230, 237, 249, 0.22);
      --panel: rgba(12, 22, 48, 0.8);
    }

    *, *::before, *::after { box-sizing: inherit; }
    html { scroll-behavior: smooth; scroll-padding-top: env(safe-area-inset-top, 0px); }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font: 400 1.15rem/1.6 var(--text);
      -webkit-font-smoothing: antialiased;
    }
    :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 4px; }

    /* ---------- 3D canvas ---------- */
    #scene {
      position: fixed; inset: 0;
      width: 100%; height: 100%;
      display: block; z-index: 0;
      pointer-events: none;
    }
    .no-webgl #scene { display: none; }
    main { position: relative; z-index: 1; }

    /* ---------- Fixed chrome ---------- */
    .top {
      position: fixed; top: 0; left: 0; right: 0; z-index: 5;
      display: flex; justify-content: space-between; align-items: center;
      padding: calc(1rem + env(safe-area-inset-top, 0px)) clamp(1.25rem, 4vw, 3rem) 1rem;
      pointer-events: none;
    }
    .top > * { pointer-events: auto; }
    .mark {
      font: 700 1.05rem var(--display);
      letter-spacing: -0.01em;
      color: var(--ink); text-decoration: none;
      opacity: 0; transition: opacity .3s;
    }
    .show-mark .mark, .mark:focus-visible { opacity: 1; }
    .theme-btn {
      width: 2.5rem; height: 2.5rem; border-radius: 50%;
      border: 2px solid var(--ink); background: transparent; color: var(--ink);
      display: grid; place-items: center; cursor: pointer;
      transition: background-color .2s, color .2s;
    }
    .theme-btn:hover { background: var(--ink); color: var(--bg); }
    .theme-btn svg { width: 1.15rem; height: 1.15rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .theme-btn .sun { display: none; }
    .theme-btn.is-dark .sun { display: block; }
    .theme-btn.is-dark .moon { display: none; }

    .rail {
      position: fixed; right: clamp(.75rem, 2vw, 1.5rem); top: 50%; transform: translateY(-50%);
      z-index: 5; display: flex; flex-direction: column; align-items: flex-end; gap: .35rem;
    }
    .rail a {
      display: flex; align-items: center; gap: .65rem; padding: .35rem .25rem;
      color: var(--ink); text-decoration: none; font: 600 .9rem/1 var(--display);
    }
    .rail .label { opacity: 0; transform: translateX(6px); transition: opacity .2s, transform .2s; pointer-events: none; }
    .rail a:hover .label, .rail a:focus-visible .label, .rail a[aria-current="true"] .label { opacity: 1; transform: none; }
    .rail .pip {
      width: .7rem; height: .7rem; border-radius: 50%;
      border: 2px solid var(--ink);
      transition: background-color .2s, border-color .2s, transform .2s;
    }
    .rail a[aria-current="true"] .pip { background: var(--accent); border-color: var(--accent); transform: scale(1.25); }

    /* ---------- Stations (one per 3D object) ---------- */
    .station {
      position: relative;
      min-height: 100vh; min-height: 100svh;
      display: flex; align-items: center;
      padding: 6rem clamp(1.25rem, 6vw, 5rem);
    }
    .copy { max-width: 34rem; }
    .copy.wide { max-width: 46rem; }

    h1.name {
      margin: 0 0 1.5rem;
      font-family: var(--display); font-weight: 800; font-stretch: 82%;
      font-size: clamp(4rem, 13vw, 10rem);
      line-height: .84; letter-spacing: -0.045em;
    }
    h1.name .line { display: block; overflow: hidden; padding-bottom: .06em; }
    h1.name .line > span {
      display: block; transform: translateY(105%);
      animation: rise 1.1s cubic-bezier(.2, .8, .2, 1) forwards;
    }
    h1.name .line:nth-child(2) > span { animation-delay: .14s; }
    @keyframes rise { to { transform: none; } }

    h2 {
      margin: 0 0 1.1rem;
      font: 700 clamp(2rem, 4.6vw, 3.5rem)/1.04 var(--display);
      font-stretch: 90%; letter-spacing: -0.025em;
    }
    p { margin: 0 0 1rem; max-width: 32rem; }
    .lede { font-size: 1.35rem; line-height: 1.45; }

    .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 1.75rem; }
    .btn {
      display: inline-flex; align-items: center; padding: .8rem 1.5rem; border-radius: 999px;
      background: var(--ink); color: var(--bg);
      font: 600 1rem var(--display); text-decoration: none;
      transition: background-color .2s, color .2s;
    }
    .btn:hover { background: var(--accent); color: #fff; }
    .link {
      color: var(--ink); font: 600 1rem var(--display);
      text-decoration: underline; text-decoration-color: var(--accent);
      text-decoration-thickness: 2px; text-underline-offset: .28em;
    }
    .link:hover { text-decoration-thickness: 4px; }

    .meta { margin: 1.5rem 0 1.5rem; max-width: 30rem; font: 400 .98rem/1.4 var(--display); }
    .meta > div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: .6rem 0; border-top: 1px solid var(--line); }
    .meta > div:last-child { border-bottom: 1px solid var(--line); }
    .meta dt { color: var(--muted); }
    .meta dd { margin: 0; font-weight: 600; }

    .mail {
      display: inline-block; margin: .25rem 0 0;
      font: 700 clamp(1.35rem, 3.4vw, 2.4rem)/1.1 var(--display); letter-spacing: -0.02em;
      color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent);
      text-decoration-thickness: 3px; text-underline-offset: .2em; overflow-wrap: anywhere;
    }
    .social { list-style: none; display: flex; flex-wrap: wrap; gap: 1.5rem; padding: 0; margin: 1.75rem 0 0; }
    .fine { margin-top: 2.5rem; font: 400 .9rem var(--display); color: var(--muted); }

    .hint {
      position: absolute; left: clamp(1.25rem, 6vw, 5rem); bottom: 2rem;
      font: 500 .95rem var(--display); color: var(--muted);
      transition: opacity .4s;
    }
    .scrolled .hint { opacity: 0; }

    /* ---------- Small screens: object up top, text panel below ---------- */
    @media (max-width: 759px) {
      .station { align-items: flex-end; padding: 5rem 1rem 5.5rem; }
      .copy { background: var(--panel); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); padding: 1.25rem; border-radius: 1rem; }
      h1.name { font-size: clamp(3.4rem, 17vw, 5.5rem); margin-bottom: 1rem; }
      .lede { font-size: 1.15rem; }
      .hint { display: none; }
      .meta > div { grid-template-columns: 5.5rem 1fr; }
      .rail {
        top: auto; right: auto; left: 50%; transform: translateX(-50%);
        bottom: calc(.8rem + env(safe-area-inset-bottom, 0px));
        flex-direction: row; align-items: center; gap: .1rem; padding: .2rem .6rem;
        background: var(--panel); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border-radius: 999px;
      }
      .rail .label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; opacity: 1; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      h1.name .line > span { animation: none; transform: none; }
      .rail .label, .rail .pip { transition: none; }
    }
  </style>
</head>
