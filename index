<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function () {
  'use strict';

  var doc = document.documentElement;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sections = [].slice.call(document.querySelectorAll('[data-station]'));
  var railLinks = [].slice.call(document.querySelectorAll('.rail a'));
  var themeBtn = document.getElementById('themeBtn');
  var N = sections.length;

  /* ---------- Theme ---------- */
  try {
    var saved = localStorage.getItem('portfolio-theme');
    if (!doc.hasAttribute('data-theme') && (saved === 'light' || saved === 'dark')) doc.setAttribute('data-theme', saved);
  } catch (e) {}

  function effectiveTheme() {
    var a = doc.getAttribute('data-theme');
    if (a === 'light' || a === 'dark') return a;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
  themeBtn.addEventListener('click', function () {
    var next = effectiveTheme() === 'dark' ? 'light' : 'dark';
    doc.setAttribute('data-theme', next);
    try { localStorage.setItem('portfolio-theme', next); } catch (e) {}
  });

  var onThemeChange = function () {};
  function syncThemeUI() {
    var dark = effectiveTheme() === 'dark';
    themeBtn.classList.toggle('is-dark', dark);
    themeBtn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    onThemeChange();
  }
  new MutationObserver(syncThemeUI).observe(doc, { attributes: true, attributeFilter: ['data-theme'] });
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncThemeUI);

  /* ---------- Scroll bookkeeping ---------- */
  var tops = [];
  function computeTops() {
    tops = sections.map(function (s) { return s.getBoundingClientRect().top + window.pageYOffset; });
  }
  function progressF() {
    var y = window.pageYOffset, i = 0;
    for (var k = 0; k < N - 1; k++) if (y >= tops[k]) i = k;
    var a = tops[i], b = tops[i + 1] !== undefined ? tops[i + 1] : a + 1;
    var f = i + (y - a) / Math.max(1, b - a);
    return Math.max(0, Math.min(N - 1, f));
  }
  function setActive(idx) {
    railLinks.forEach(function (a, i) {
      if (i === idx) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
    });
    doc.classList.toggle('show-mark', idx > 0);
  }
  window.addEventListener('scroll', function () {
    doc.classList.toggle('scrolled', window.pageYOffset > 40);
  }, { passive: true });

  computeTops();
  setActive(0);
  syncThemeUI();

  /* ---------- WebGL scene ---------- */
  if (typeof THREE === 'undefined') { doc.classList.add('no-webgl'); return; }

  var canvas = document.getElementById('scene');
  var renderer;
  try {
    renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
  } catch (e) { doc.classList.add('no-webgl'); return; }
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
  renderer.setClearColor(0x000000, 0);

  var scene = new THREE.Scene();
  scene.fog = new THREE.Fog(0xd8e5ec, 12, 44);
  var camera = new THREE.PerspectiveCamera(40, 1, 0.1, 200);
  scene.add(camera);

  var hemi = new THREE.HemisphereLight(0xffffff, 0x8fa3bd, 0.75);
  scene.add(hemi);
  var key = new THREE.DirectionalLight(0xffffff, 0.9);
  key.position.set(4, 6, 8);
  key.target.position.set(0, 0, -10);
  camera.add(key);
  camera.add(key.target);

  var C = { cobalt: 0x2f4bff, butter: 0xf2d675, rose: 0xe8a59a, pale: 0xe9eef5 };
  function mat(color) {
    return new THREE.MeshStandardMaterial({ color: color, roughness: 0.5, metalness: 0.05, flatShading: true });
  }
  var inkMats = [];
  function inkLine(opacity) {
    var m = new THREE.LineBasicMaterial({ color: 0x0f1b33, transparent: true, opacity: opacity });
    inkMats.push(m); return m;
  }
  function inkWire(opacity) {
    var m = new THREE.MeshBasicMaterial({ color: 0x0f1b33, wireframe: true, transparent: true, opacity: opacity });
    inkMats.push(m); return m;
  }

  onThemeChange = function () {
    var cs = getComputedStyle(doc);
    var bg = new THREE.Color(cs.getPropertyValue('--bg').trim() || '#d8e5ec');
    var ink = new THREE.Color(cs.getPropertyValue('--ink').trim() || '#0f1b33');
    var dark = (bg.r + bg.g + bg.b) < 1.5;
    scene.fog.color.copy(bg);
    inkMats.forEach(function (m) { m.color.copy(ink); });
    hemi.intensity = dark ? 0.6 : 0.75;
    key.intensity = dark ? 0.8 : 0.9;
  };

  /* ----- Station objects ----- */
  function makeHero() {
    var g = new THREE.Group();
    var core = new THREE.Mesh(new THREE.IcosahedronGeometry(1.4, 1), mat(C.cobalt));
    var shell = new THREE.Mesh(new THREE.IcosahedronGeometry(1.95, 1), inkWire(0.4));
    var r1 = new THREE.Mesh(new THREE.TorusGeometry(2.45, 0.07, 16, 120), mat(C.butter));
    r1.rotation.x = Math.PI / 2.4;
    var r2 = new THREE.Mesh(new THREE.TorusGeometry(2.8, 0.045, 16, 120), mat(C.rose));
    r2.rotation.set(Math.PI / 2.9, 0.6, 0);
    var moon = new THREE.Mesh(new THREE.SphereGeometry(0.25, 24, 16), mat(C.butter));
    r1.add(moon);
    g.add(core, shell, r1, r2);
    g.userData.update = function (t) {
      core.rotation.y = t * 0.25;
      shell.rotation.set(t * 0.1, -t * 0.15, 0);
      r2.rotation.z = t * 0.12;
      moon.position.set(Math.cos(t * 0.9) * 2.45, Math.sin(t * 0.9) * 2.45, 0);
    };
    return g;
  }

  function makeStack() {
    var g = new THREE.Group();
    var cols = [C.cobalt, C.butter, C.rose, C.pale], slabs = [];
    for (var i = 0; i < 9; i++) {
      var w = 2.6 - i * 0.12;
      var m = new THREE.Mesh(new THREE.BoxGeometry(w, 0.3, w), mat(cols[i % 4]));
      m.position.y = (i - 4) * 0.46;
      m.rotation.y = i * 0.32;
      g.add(m); slabs.push(m);
    }
    g.rotation.x = 0.25;
    g.userData.update = function (t) {
      slabs.forEach(function (m, i) { m.rotation.y = i * 0.32 + Math.sin(t * 0.6 + i * 0.4) * 0.28; });
    };
    return g;
  }

  function makeKnot() {
    var g = new THREE.Group();
    var knot = new THREE.Mesh(new THREE.TorusKnotGeometry(1.45, 0.4, 200, 24, 2, 3), mat(C.rose));
    var a = new THREE.Mesh(new THREE.SphereGeometry(0.22, 20, 14), mat(C.cobalt));
    var b = new THREE.Mesh(new THREE.SphereGeometry(0.16, 20, 14), mat(C.butter));
    var orbit = new THREE.Mesh(new THREE.TorusGeometry(2.6, 0.03, 12, 120), inkWire(0.5));
    orbit.rotation.x = Math.PI / 2.2;
    g.add(knot, a, b, orbit);
    g.userData.update = function (t) {
      knot.rotation.set(t * 0.2, t * 0.3, 0);
      a.position.set(Math.cos(t * 0.8) * 2.6, Math.sin(t * 0.8) * 2.6 * Math.cos(Math.PI / 2.2), Math.sin(t * 0.8) * 2.6 * Math.sin(Math.PI / 2.2));
      b.position.set(Math.cos(-t * 0.6 + 2) * 2.2, 0.3, Math.sin(-t * 0.6 + 2) * 2.2);
    };
    return g;
  }

  function makeBars() {
    var g = new THREE.Group(), bars = [];
    var cols = [C.cobalt, C.butter, C.rose];
    for (var x = -2; x <= 2; x++) {
      for (var z = -2; z <= 2; z++) {
        var m = new THREE.Mesh(new THREE.CylinderGeometry(0.32, 0.32, 1, 20), mat(cols[((x + 2) * 5 + (z + 2)) % 3]));
        m.position.set(x * 0.78, 0, z * 0.78);
        g.add(m); bars.push({ m: m, x: x, z: z });
      }
    }
    var base = new THREE.Mesh(new THREE.CylinderGeometry(2.9, 2.9, 0.12, 48), mat(C.pale));
    base.position.y = -1.25;
    g.add(base);
    g.rotation.x = 0.4;
    function setH(t) {
      bars.forEach(function (b) {
        var h = 0.5 + (Math.sin(t * 0.8 + b.x * 0.9 + b.z * 1.3) + 1) * 0.7 + Math.abs(b.x * b.z) * 0.12;
        b.m.scale.y = h; b.m.position.y = h / 2 - 1.2;
      });
    }
    setH(0);
    g.userData.update = setH;
    return g;
  }

  function makeLattice() {
    var g = new THREE.Group();
    var ico = new THREE.IcosahedronGeometry(2.2, 0);
    var lines = new THREE.LineSegments(new THREE.EdgesGeometry(ico), inkLine(0.7));
    var verts = [], pos = ico.attributes.position, seen = {};
    for (var i = 0; i < pos.count; i++) {
      var k = pos.getX(i).toFixed(3) + ',' + pos.getY(i).toFixed(3) + ',' + pos.getZ(i).toFixed(3);
      if (!seen[k]) { seen[k] = 1; verts.push(new THREE.Vector3(pos.getX(i), pos.getY(i), pos.getZ(i))); }
    }
    var outer = new THREE.Group();
    outer.add(lines);
    verts.forEach(function (v) {
      var s = new THREE.Mesh(new THREE.SphereGeometry(0.2, 20, 14), mat(C.butter));
      s.position.copy(v); outer.add(s);
    });
    var inner = new THREE.Mesh(new THREE.OctahedronGeometry(1.0, 0), mat(C.cobalt));
    g.add(outer, inner);
    g.userData.update = function (t) {
      outer.rotation.set(t * 0.12, t * 0.2, 0);
      inner.rotation.set(-t * 0.3, -t * 0.2, t * 0.1);
    };
    return g;
  }

  var pointerX = 0, pointerY = 0;
  function makePortal() {
    var g = new THREE.Group();
    var ring = new THREE.Mesh(new THREE.TorusGeometry(2.1, 0.5, 32, 96), mat(C.butter));
    var orb = new THREE.Mesh(new THREE.SphereGeometry(1.0, 48, 32), mat(C.cobalt));
    var cubes = [];
    for (var i = 0; i < 8; i++) {
      var c = new THREE.Mesh(new THREE.BoxGeometry(0.26, 0.26, 0.26), mat(i % 2 ? C.rose : C.pale));
      g.add(c); cubes.push(c);
    }
    g.add(ring, orb);
    g.userData.update = function (t) {
      ring.rotation.set(t * 0.25, t * 0.15, 0);
      orb.position.x += (pointerX * 0.5 - orb.position.x) * 0.06;
      orb.position.y += (-pointerY * 0.5 - orb.position.y) * 0.06;
      cubes.forEach(function (c, i) {
        var a = t * 0.5 + (i / 8) * Math.PI * 2;
        c.position.set(Math.cos(a) * 3.2, Math.sin(a) * 1.1, Math.sin(a) * 3.2 * 0.6);
        c.rotation.set(a, a * 0.7, 0);
      });
    };
    return g;
  }

  /* Object positions in the space. Camera glides from one to the next. */
  var O = [[0, 0, 0], [7, -1.5, -15], [-6, 1.5, -30], [7, -1, -45], [-6, 1.2, -60], [1, 0, -75]];
  var SWAY = [0, 3.2, -3.2, 3.2, -3.2, 0];
  var makers = [makeHero, makeStack, makeKnot, makeBars, makeLattice, makePortal];
  var objs = [];
  makers.forEach(function (make, i) {
    if (i >= N) return;
    var group = make();
    var holder = new THREE.Group();
    holder.add(group);
    holder.position.set(O[i][0], O[i][1], O[i][2]);
    scene.add(holder);
    objs.push({ holder: holder, group: group, spin: 0, boost: 0, tx: 0, ty: 0 });
  });
  var count = objs.length;

  /* Floating shards for depth */
  var SHARDS = 240;
  var shardMesh = new THREE.InstancedMesh(new THREE.OctahedronGeometry(1, 0),
    new THREE.MeshStandardMaterial({ roughness: 0.6, flatShading: true }), SHARDS);
  var shardBase = [], shardPhase = [], shardSpeed = [], shardScale = [];
  var palette = [C.cobalt, C.butter, C.rose, C.pale].map(function (c) { return new THREE.Color(c); });
  function lerp(a, b, f) { return a + (b - a) * f; }
  for (var s = 0; s < SHARDS; s++) {
    var p, tries = 0, ok;
    do {
      var kk = Math.random() * (count - 1), a = Math.floor(kk), b = Math.min(a + 1, count - 1), ff = kk - a;
      p = new THREE.Vector3(
        lerp(O[a][0], O[b][0], ff) + (Math.random() - 0.5) * 26,
        lerp(O[a][1], O[b][1], ff) + (Math.random() - 0.5) * 14,
        lerp(O[a][2], O[b][2], ff) + (Math.random() - 0.5) * 18);
      ok = true;
      for (var q = 0; q < count; q++) {
        if (p.distanceTo(new THREE.Vector3(O[q][0], O[q][1], O[q][2])) < 4.5) { ok = false; break; }
      }
      tries++;
    } while (!ok && tries < 12);
    shardBase.push(p);
    shardPhase.push(Math.random() * 6.28);
    shardSpeed.push(0.2 + Math.random() * 0.5);
    shardScale.push(0.05 + Math.random() * 0.17);
    shardMesh.setColorAt(s, palette[s % 4]);
  }
  scene.add(shardMesh);
  var dummy = new THREE.Object3D();
  function updateShards(t) {
    for (var i = 0; i < SHARDS; i++) {
      dummy.position.copy(shardBase[i]);
      dummy.position.y += Math.sin(t * shardSpeed[i] + shardPhase[i]) * 0.35;
      dummy.rotation.set(t * shardSpeed[i], t * shardSpeed[i] * 0.7 + shardPhase[i], 0);
      dummy.scale.setScalar(shardScale[i]);
      dummy.updateMatrix();
      shardMesh.setMatrixAt(i, dummy.matrix);
    }
    shardMesh.instanceMatrix.needsUpdate = true;
  }
  updateShards(0);

  /* ----- Camera path (rebuilt on resize because layout differs on phones) ----- */
  var camCurve, lookCurve, objScale = 1, narrow = false;
  function rebuildPath() {
    var offx = narrow ? 0 : 3.4, offy = narrow ? -2.6 : 0;
    var dist = narrow ? 15 : 11.5, sw = narrow ? 0.4 : 1;
    var cp = [], lp = [];
    for (var i = 0; i < count; i++) {
      var L = new THREE.Vector3(O[i][0] - offx, O[i][1] + offy, O[i][2]);
      lp.push(L);
      cp.push(new THREE.Vector3(L.x + SWAY[i] * sw, L.y + 0.6, L.z + dist));
    }
    camCurve = new THREE.CatmullRomCurve3(cp, false, 'catmullrom', 0.5);
    lookCurve = new THREE.CatmullRomCurve3(lp, false, 'catmullrom', 0.5);
    objScale = narrow ? 0.72 : 1;
  }

  function layout() {
    var w = window.innerWidth, h = window.innerHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    narrow = w < 760 || w / h < 0.85;
    rebuildPath();
    computeTops();
  }
  window.addEventListener('resize', layout);
  if (window.ResizeObserver) new ResizeObserver(computeTops).observe(document.body);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(computeTops);
  layout();
  syncThemeUI();

  window.addEventListener('pointermove', function (e) {
    pointerX = (e.clientX / window.innerWidth) * 2 - 1;
    pointerY = (e.clientY / window.innerHeight) * 2 - 1;
  }, { passive: true });

  /* ----- Render loop ----- */
  function easeOutBack(x) { var c1 = 1.70158, c3 = c1 + 1; return 1 + c3 * Math.pow(x - 1, 3) + c1 * Math.pow(x - 1, 2); }
  function clamp01(x) { return x < 0 ? 0 : x > 1 ? 1 : x; }

  var camPos = new THREE.Vector3(), lookPos = new THREE.Vector3();
  var last = performance.now(), t = 0, f = progressF(), activeIdx = -1;
  var px = 0, py = 0;

  function frame(now) {
    requestAnimationFrame(frame);
    var dt = Math.min((now - last) / 1000, 0.05); last = now; t += dt;

    var target = progressF();
    f = reduce ? target : f + (target - f) * (1 - Math.exp(-dt * 5));

    /* Ease inside each segment so the camera lingers at every station */
    var fi = Math.min(Math.floor(f), count - 2), fr = clamp01(f - fi);
    var fe = fi + fr * fr * fr * (fr * (fr * 6 - 15) + 10);
    var tt = fe / (count - 1);
    camCurve.getPoint(tt, camPos);
    lookCurve.getPoint(tt, lookPos);

    if (!reduce) {
      var k = 1 - Math.exp(-dt * 4);
      px += (pointerX - px) * k; py += (pointerY - py) * k;
    }
    camera.position.set(camPos.x + px * 0.7, camPos.y - py * 0.45, camPos.z);
    camera.lookAt(lookPos);

    var idx = Math.max(0, Math.min(count - 1, Math.round(fe)));
    if (idx !== activeIdx) {
      activeIdx = idx; setActive(idx);
      if (!reduce) objs[idx].boost = 5;
    }

    var intro = reduce ? 1 : easeOutBack(clamp01((t - 0.15) / 1.7));
    var kt = 1 - Math.exp(-dt * 5);
    for (var i = 0; i < count; i++) {
      var o = objs[i], d = Math.abs(fe - i);
      var vis = d < 2.4;
      o.holder.visible = vis;
      if (!vis) continue;
      var w = clamp01(1 - d);
      var grow = clamp01((2.4 - d) / 0.8);
      grow = grow * grow * (3 - 2 * grow);
      o.holder.scale.setScalar(objScale * grow * (i === 0 ? intro : 1));

      o.boost *= Math.exp(-dt * 2.5);
      o.spin += ((reduce ? 0 : 0.12) + o.boost) * dt;
      o.tx += (py * 0.3 * w - o.tx) * kt;
      o.ty += (px * 0.6 * w - o.ty) * kt;
      o.holder.rotation.set(o.tx, o.spin + o.ty, 0);
      if (!reduce) o.group.userData.update(t, dt);
    }
    if (!reduce) updateShards(t);

    renderer.render(scene, camera);
  }
  requestAnimationFrame(frame);
})();
</script>
</body>
</html>
